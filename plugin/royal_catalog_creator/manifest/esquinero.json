{
  "familia": "esquinero",
  "titulo": "Esquinero",
  "descripcion": "Módulo base de esquinero.",
  "componente_base": "Main Components/ESQUINERO.skp",
  "salida_dir": "Output/Esquineros",
  "nombre_patron": "ESQ-{LenX}-{divisor>f01cantdiv}div",
  "reglas_union": {
    "grupo": "entrepaño",
    "piezas": ["p01-esq", "p02-esq"],
    "nombre": "Entrepaño"
  },
  "reglas_divisores": {
    "prefijo": "divisor",
    "attr_cantidad": "divisor>f01cantdiv",
    "nombre_default": "Entrepaño",
    "presupuesto": {
      "attr_alto_util": "LenZ",
      "solo_si": { "attr": "divisor>f02tipomedida", "valor": "2" },
      "attrs_espacio": [
        "divisor>f03espacio1", "divisor>f03espacio2", "divisor>f03espacio3",
        "divisor>f03espacio4", "divisor>f03espacio5", "divisor>f03espacio6"
      ]
    }
  },
  "reglas_geometria": [
    { "attrs": ["a02zocalo"], "menor_que": "LenZ", "mensaje": "El zócalo no puede alcanzar el alto del cuerpo." },
    { "attrs": ["f11margsupcaj", "f12marginfcaj"], "menor_que": "LenZ", "mensaje": "Los márgenes superior e inferior no dejan frente: suman más que el alto." },
    { "attrs": ["f13margizqcaj", "f14margdercaj"], "menor_que": "LenX", "mensaje": "Los márgenes izquierdo y derecho no dejan frente: suman más que el ancho izquierdo." },
    { "attrs": ["c01espestr"], "menor_que": "LenX", "mensaje": "El espesor de estructura no puede alcanzar el ancho izquierdo." },
    { "attrs": ["c01espestr"], "menor_que": "LenY", "mensaje": "El espesor de estructura no puede alcanzar el ancho derecho." },
    { "attrs": ["c01espestr"], "menor_que": "LenZ", "mensaje": "El espesor de estructura no puede alcanzar el alto." },
    { "attrs": ["c02esppuerta"], "menor_que": "a0101profizq", "mensaje": "El espesor de puerta no puede alcanzar la profundidad izquierda." },
    { "attrs": ["c02esppuerta"], "menor_que": "a0102profder", "mensaje": "El espesor de puerta no puede alcanzar la profundidad derecha." },
    { "attrs": ["c03espfondo"], "menor_que": "a0101profizq", "mensaje": "El espesor de fondo no puede alcanzar la profundidad izquierda." },
    { "attrs": ["c03espfondo"], "menor_que": "a0102profder", "mensaje": "El espesor de fondo no puede alcanzar la profundidad derecha." }
  ],
  "grupos": [
    {
      "id": "dimensiones",
      "titulo": "Dimensiones",
      "campos": [
        { "id": "LenX", "attr": "LenX", "label": "Ancho izquierdo", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "900", "positivo": true, "requerido": true },
        { "id": "LenY", "attr": "LenY", "label": "Ancho derecho", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "900", "positivo": true, "requerido": true },
        { "id": "LenZ", "attr": "LenZ", "label": "Alto", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "600", "positivo": true, "requerido": true, "nota": "Alto del cuerpo; el zócalo se suma aparte.", "suma": [
          { "attr": "a02zocalo" }
        ] },
        { "id": "a0101profizq", "attr": "a0101profizq", "label": "Profundidad izquierda", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "600", "positivo": true, "requerido": true, "nota": "Profundidad del cuerpo; si la puerta va por fuera se le suma su espesor.", "suma": [
          { "attr": "c02esppuerta", "si": [
            { "attr": "EstiloPuerta", "excepto": ["0"] },
            { "attr": "puerta>f01posextintpu", "valor": "1" }
          ] }
        ] },
        { "id": "a0102profder", "attr": "a0102profder", "label": "Profundidad derecha", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "600", "positivo": true, "requerido": true, "nota": "Profundidad del cuerpo; si la puerta va por fuera se le suma su espesor.", "suma": [
          { "attr": "c02esppuerta", "si": [
            { "attr": "EstiloPuerta", "excepto": ["0"] },
            { "attr": "puerta>f01posextintpu", "valor": "1" }
          ] }
        ] },
        { "id": "a02zocalo", "attr": "a02zocalo", "label": "Alto zócalo", "tipo": "numero", "unidad": "mm", "default": "100", "placeholder": "100" }
      ]
    },
    {
      "id": "espesores",
      "titulo": "Espesores",
      "campos": [
        { "id": "c01espestr", "attr": "c01espestr", "label": "Espesor estructura", "tipo": "numero", "unidad": "mm", "default": "18", "placeholder": "18", "positivo": true },
        { "id": "c02esppuerta", "attr": "c02esppuerta", "label": "Espesor puerta", "tipo": "numero", "unidad": "mm", "default": "18", "placeholder": "18", "positivo": true },
        { "id": "c03espfondo", "attr": "c03espfondo", "label": "Espesor fondo", "tipo": "numero", "unidad": "mm", "default": "12", "placeholder": "12", "positivo": true }
      ]
    },
    {
      "id": "estructura",
      "titulo": "Estructura e interior",
      "campos": [
        { "id": "c24entrepano", "attr": "c24entrepano", "label": "Entrepaño", "tipo": "select", "default": "1", "nota": "Interruptor maestro de la sección Divisores.", "opciones": [
          { "label": "Sí", "valor": "0" },
          { "label": "No", "valor": "1" }
        ] }
      ]
    },
    {
      "id": "frente",
      "titulo": "Frente y puertas",
      "box_model": {
        "titulo": "Márgenes del frente",
        "centro": "Frente",
        "arriba": "f11margsupcaj",
        "abajo": "f12marginfcaj",
        "izquierda": "f13margizqcaj",
        "derecha": "f14margdercaj"
      },
      "campos": [
        { "id": "EstiloPuerta", "attr": "EstiloPuerta", "label": "Diseño de puerta", "tipo": "select", "default": "1", "nota": "El esquinero lleva siempre una sola puerta.", "opciones": [
          { "label": "Ninguna", "valor": "0" },
          { "label": "Puerta lisa", "valor": "1" },
          { "label": "Puerta italiana", "valor": "2" },
          { "label": "Puerta vidrio", "valor": "3" },
          { "label": "Puerta vidrio-madera", "valor": "4" },
          { "label": "Puerta uñero", "valor": "5" }
        ] },
        { "id": "f01posextintpu", "attr": "puerta>f01posextintpu", "label": "Posición de puertas", "tipo": "select", "default": "1",
          "habilitado_si": { "attr": "EstiloPuerta", "excepto": ["0"], "mensaje": "Sin puerta no hay nada que posicionar." }, "opciones": [
          { "label": "Puerta/Cajón exterior", "valor": "1" },
          { "label": "Puerta/Cajón interior", "valor": "2" }
        ] },
        { "id": "f11margsupcaj", "attr": "f11margsupcaj", "label": "Margen superior", "label_corto": "Superior", "tipo": "numero", "unidad": "mm", "default": "0", "placeholder": "0",
          "habilitado_si": { "attr": "EstiloPuerta", "excepto": ["0"], "mensaje": "Sin puerta no hay frente que margenar." } },
        { "id": "f12marginfcaj", "attr": "f12marginfcaj", "label": "Margen inferior", "label_corto": "Inferior", "tipo": "numero", "unidad": "mm", "default": "0", "placeholder": "0",
          "habilitado_si": { "attr": "EstiloPuerta", "excepto": ["0"], "mensaje": "Sin puerta no hay frente que margenar." } },
        { "id": "f13margizqcaj", "attr": "f13margizqcaj", "label": "Margen izquierdo", "label_corto": "Izquierdo", "tipo": "numero", "unidad": "mm", "default": "2", "placeholder": "2",
          "habilitado_si": { "attr": "EstiloPuerta", "excepto": ["0"], "mensaje": "Sin puerta no hay frente que margenar." } },
        { "id": "f14margdercaj", "attr": "f14margdercaj", "label": "Margen derecho", "label_corto": "Derecho", "tipo": "numero", "unidad": "mm", "default": "2", "placeholder": "2",
          "habilitado_si": { "attr": "EstiloPuerta", "excepto": ["0"], "mensaje": "Sin puerta no hay frente que margenar." } }
      ]
    },
    {
      "id": "tirador",
      "titulo": "Tirador",
      "condicion": { "attr": "EstiloPuerta", "excepto": ["0", "3", "5"], "mensaje": "Sin puerta, con vidrio completo o con uñero no hay dónde montar un tirador." },
      "campos": [
        { "id": "f21tipotirador", "attr": "puerta>f21tipotirador", "label": "Tipo de tirador", "tipo": "select", "default": "1", "opciones": [
          { "label": "Sin tirador", "valor": "1" },
          { "label": "Tirador secc. circular", "valor": "2" },
          { "label": "Tirador secc. cuadrada", "valor": "3" },
          { "label": "Tirador arco", "valor": "4" },
          { "label": "Tirador botón cuadrado", "valor": "5" },
          { "label": "Tirador botón circular", "valor": "6" },
          { "label": "Tirador CLE", "valor": "7" }
        ] },
        { "id": "f22postirador", "attr": "puerta>f22postirador", "label": "Posición de tirador", "tipo": "select", "default": "3",
          "habilitado_si": { "attr": "puerta>f21tipotirador", "excepto": ["1"], "mensaje": "Sin tirador no hay pieza que posicionar." }, "opciones": [
          { "label": "Arriba - Izquierda", "valor": "1" },
          { "label": "Arriba - Centro", "valor": "2" },
          { "label": "Arriba - Derecha", "valor": "3" },
          { "label": "Centro - Izquierda", "valor": "4" },
          { "label": "Centro - Centro", "valor": "5" },
          { "label": "Centro - Derecha", "valor": "6" },
          { "label": "Abajo - Izquierda", "valor": "7" },
          { "label": "Abajo - Centro", "valor": "8" },
          { "label": "Abajo - Derecha", "valor": "9" }
        ] },
        { "id": "f23orienttirador", "attr": "puerta>f23orienttirador", "label": "Orientación de tirador", "tipo": "select", "default": "2",
          "habilitado_si": { "attr": "puerta>f21tipotirador", "excepto": ["1"], "mensaje": "Sin tirador no hay pieza que orientar." }, "opciones": [
          { "label": "Tirador horizontal", "valor": "1" },
          { "label": "Tirador vertical", "valor": "2" }
        ] }
      ]
    },
    {
      "id": "divisores",
      "titulo": "Divisores",
      "presupuesto": "divisores",
      "condicion": { "attr": "c24entrepano", "valor": "0", "mensaje": "Se activa con «Entrepaño: Sí»." },
      "box_model": {
        "titulo": "Márgenes del divisor (vista de planta)",
        "centro": "Planta",
        "arriba": "divisor>e32_marg2",
        "abajo": "divisor>e31_marg1",
        "izquierda": "divisor>e33_marg3",
        "derecha": "divisor>e34_marg4"
      },
      "campos": [
        { "id": "f01cantdiv", "attr": "divisor>f01cantdiv", "label": "Cantidad de divisores", "tipo": "derivado", "default": "1", "min": 1, "max": 6, "controla": ["divisor>f03espacio"] },
        { "id": "f02tipomedida", "attr": "divisor>f02tipomedida", "label": "Tipo de medida", "tipo": "select", "default": "1", "opciones": [
          { "label": "Separaciones iguales", "valor": "1" },
          { "label": "Personalizado", "valor": "2" }
        ] },
        { "id": "e31_marg1", "attr": "divisor>e31_marg1", "label": "Margen frontal", "label_corto": "Frontal", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "0", "auto": true },
        { "id": "e32_marg2", "attr": "divisor>e32_marg2", "label": "Margen posterior", "label_corto": "Posterior", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "0", "auto": true },
        { "id": "e33_marg3", "attr": "divisor>e33_marg3", "label": "Margen izquierdo", "label_corto": "Izquierdo", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "0", "auto": true },
        { "id": "e34_marg4", "attr": "divisor>e34_marg4", "label": "Margen derecho", "label_corto": "Derecho", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "0", "auto": true },
        { "id": "f03espacio1", "attr": "divisor>f03espacio1", "label": "Espacio 1 (inferior)", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "150", "positivo": true, "visible_si": { "attr": "divisor>f01cantdiv", "min": 1 }, "habilitado_si": { "attr": "divisor>f02tipomedida", "valor": "2", "mensaje": "Solo aplica con tipo de medida «Personalizado»." } },
        { "id": "f03espacio2", "attr": "divisor>f03espacio2", "label": "Espacio 2", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "150", "positivo": true, "visible_si": { "attr": "divisor>f01cantdiv", "min": 2 }, "habilitado_si": { "attr": "divisor>f02tipomedida", "valor": "2", "mensaje": "Solo aplica con tipo de medida «Personalizado»." } },
        { "id": "f03espacio3", "attr": "divisor>f03espacio3", "label": "Espacio 3", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "150", "positivo": true, "visible_si": { "attr": "divisor>f01cantdiv", "min": 3 }, "habilitado_si": { "attr": "divisor>f02tipomedida", "valor": "2", "mensaje": "Solo aplica con tipo de medida «Personalizado»." } },
        { "id": "f03espacio4", "attr": "divisor>f03espacio4", "label": "Espacio 4", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "150", "positivo": true, "visible_si": { "attr": "divisor>f01cantdiv", "min": 4 }, "habilitado_si": { "attr": "divisor>f02tipomedida", "valor": "2", "mensaje": "Solo aplica con tipo de medida «Personalizado»." } },
        { "id": "f03espacio5", "attr": "divisor>f03espacio5", "label": "Espacio 5", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "150", "positivo": true, "visible_si": { "attr": "divisor>f01cantdiv", "min": 5 }, "habilitado_si": { "attr": "divisor>f02tipomedida", "valor": "2", "mensaje": "Solo aplica con tipo de medida «Personalizado»." } },
        { "id": "f03espacio6", "attr": "divisor>f03espacio6", "label": "Espacio 6", "tipo": "numero", "unidad": "mm", "default": "", "placeholder": "150", "positivo": true, "visible_si": { "attr": "divisor>f01cantdiv", "min": 6 }, "habilitado_si": { "attr": "divisor>f02tipomedida", "valor": "2", "mensaje": "Solo aplica con tipo de medida «Personalizado»." } }
      ]
    }
  ]
}
