{"nodes": [{"id": "plugin_readme_presupuesto_cajones", "label": "Presupuesto de alto de cajones (implementaci\u00f3n en el plugin)", "file_type": "concept", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_box_model_margenes", "label": "Editor de caja (box_model) para los m\u00e1rgenes del frente", "file_type": "concept", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_reglas_union", "label": "reglas_union \u2014 fusi\u00f3n de mitades declarada como dato", "file_type": "concept", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_limpieza_ocultos", "label": "Limpieza de piezas ocultas (Engine.eliminar_ocultos)", "file_type": "concept", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_buscar_para_modificar", "label": "Engine.buscar_para_modificar \u2014 independizar cada contenedor anidado", "file_type": "rationale", "rationale": "make_unique solo independiza la definici\u00f3n ra\u00edz; instances.size == 1 no prueba exclusividad porque un ancestro compartido dibuja esa instancia dentro del componente base. Sin independizar cada contenedor por el que se pasa, generar mutilar\u00eda el modelo base.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_generar_todos_lote", "label": "\u00abGenerar todos\u00bb \u2014 cola secuencial con cancelaci\u00f3n por unidad", "file_type": "concept", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_registro_id", "label": "registro_id en el payload y en todas las respuestas de generar", "file_type": "rationale", "rationale": "Sin \u00e9l onGenerar marcaba como generado al m\u00f3dulo activo, correcto con un bot\u00f3n individual y equivocado en cuanto hay una cola. El bot\u00f3n individual usa el mismo camino para que no haya dos rutas de generaci\u00f3n que puedan divergir.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_reparto_responsabilidades_import", "label": "Ruby parsea, JavaScript valida (importaci\u00f3n)", "file_type": "rationale", "rationale": "importer.rb solo convierte archivo\u2192matriz de texto y no conoce el manifiesto; toda la sem\u00e1ntica se resuelve en app.js con los mismos predicados del formulario, para no crear un tercer espejo de las reglas que ser\u00eda el que se desincronizar\u00eda.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_xlsx_sin_gems", "label": "Escritura de .xlsx sin gems (zip sin comprimir, cadenas inline)", "file_type": "rationale", "rationale": "SketchUp no trae rubyzip ni puede instalarlo, as\u00ed que el archivo se arma a mano con entradas sin comprimir y cadenas inline; de zlib solo se usa el CRC32 con respaldo propio. A cambio se obtienen desplegables nativos (dataValidation), que era el punto de usar Excel y no CSV.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_empaquetar_rbz", "label": "Empaquetar el .rbz (estructura y separador de rutas)", "file_type": "concept", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_plantilla_sin_selector", "label": "La plantilla se descarga sin selector de ruta", "file_type": "rationale", "rationale": "El selector de guardado se confund\u00eda con el de \u00abImportar\u2026\u00bb y quien cre\u00eda estar cargando su captura acababa reemplaz\u00e1ndola por la plantilla en blanco; por eso escribe directo en Descargas, numerando si ya existe.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_controles_propios_tabla", "label": "La tabla de revisi\u00f3n usa controles propios", "file_type": "rationale", "rationale": "ctrlSelect/ctrlPreset/ctrlStepper y updateConditionals localizan sus elementos con document.querySelector global, as\u00ed que con N filas todas las instancias chocar\u00edan; en la tabla solo hace falta capturar texto.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_csv_windows_1252", "label": "Detecci\u00f3n de CSV en Windows-1252", "file_type": "rationale", "rationale": "\u00abGuardar como CSV\u00bb de Excel en Windows no escribe UTF-8; sin la conversi\u00f3n \u00abPuerta u\u00f1ero\u00bb no coincidir\u00eda con ninguna opci\u00f3n del manifiesto.", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugin_readme_pendientes_definicion", "label": "Notas de la definici\u00f3n pendientes con el mantenedor", "file_type": "document", "source_file": "plugin/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_build_ps1", "target": "plugin_readme_empaquetar_rbz", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugin/README.md", "source_location": "149-165", "weight": 1.0}, {"source": "manual_tec