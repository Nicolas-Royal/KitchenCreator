{"nodes": [{"id": "manual_tecnico_arquitectura_ruby_js", "label": "Separaci\u00f3n estricta Ruby (modelo/disco) vs JavaScript (sem\u00e1ntica)", "file_type": "rationale", "rationale": "Ruby es el \u00fanico que toca el modelo 3D y el disco; JavaScript resuelve la sem\u00e1ntica del formulario. Mantener la frontera evita duplicar el motor de inyecci\u00f3n y concentra la validaci\u00f3n en un solo lenguaje.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_puente_mensajes", "label": "Puente de mensajes JS\u2194Ruby (6 callbacks / 5 receptores)", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_main_rb", "label": "main.rb \u2014 capa de aplicaci\u00f3n, men\u00fa, di\u00e1logo y callbacks", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_engine_rb", "label": "engine.rb \u2014 motor de inyecci\u00f3n y post-procesos geom\u00e9tricos", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_plantilla_rb", "label": "plantilla.rb \u2014 modelo de columnas derivado de los manifiestos", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_xlsx_rb", "label": "xlsx.rb \u2014 lector/escritor m\u00ednimo de .xlsx sin gems", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_importer_rb", "label": "importer.rb \u2014 parseo estructural de CSV/XLSX", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_app_js", "label": "app.js \u2014 render, reglas condicionales, validaci\u00f3n y lote", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_manifiesto", "label": "Manifiesto por familia \u2014 fuente \u00fanica de la UI", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a76.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_motor_agnostico_familia", "label": "Motor agn\u00f3stico a la familia", "file_type": "rationale", "rationale": "No hay condicionales por tipo de mueble en el c\u00f3digo: agregar una familia es soltar un JSON y su .skp. Todo el comportamiento espec\u00edfico se declara como dato en el manifiesto.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_notacion_prefijo_atributo", "label": "Notaci\u00f3n \u00abprefijo>atributo\u00bb y conversi\u00f3n de unidades a pulgadas", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_medida_cuerpo_vs_total", "label": "El formulario captura la medida del cuerpo, no la total (bloque \u00absuma\u00bb)", "file_type": "rationale", "rationale": "El manifiesto declara qu\u00e9 se suma antes de inyectar (z\u00f3calo al alto, espesor de puerta a la profundidad y solo con puerta exterior); la UI muestra el total resultante para que la suma no sea invisible. Se resuelve en effectiveValue y no en el aplanado, para que el presupuesto de cajones lea el alto ya compensado sin desincronizar los espejos.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_reglas_condicionales", "label": "Reglas condicionales por campo (habilitado_si / visible_si)", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a76.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_prefijos_aplicabilidad", "label": "Prefijos de aplicabilidad de columna [GAB]\u00b7[ALA]\u00b7[ESQ]", "file_type": "rationale", "rationale": "La columna se identifica por el campo completo y no por el atributo: dos familias la comparten solo si coinciden attr, tipo, unidad, etiqueta y todo el juego de opciones. Sin esa regla EstiloPuerta ofrecer\u00eda \u00ab4 cajones\u00bb en un Esquinero y LenY mezclar\u00eda \u00abProfundidad\u00bb con \u00abAncho derecho\u00bb.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a76.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_presupuesto_cajones", "label": "Presupuesto de alto de cajones", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_espejo_reglas_cajones", "label": "Regla de cajones implementada dos veces (app.js y main.rb)", "file_type": "rationale", "rationale": "Deuda asumida a prop\u00f3sito: se aceptan dos espejos \u2014JS para la captura, Ruby para bloquear la generaci\u00f3n\u2014 porque un tercer espejo en el importador ser\u00eda el que se desincronizar\u00eda; por eso el importador se dej\u00f3 sin sem\u00e1ntica.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_lote_secuencial", "label": "Lote estrictamente secuencial", "file_type": "rationale", "rationale": "El puente Ruby\u2194JS es as\u00edncrono y el cursor de auto-tiling avanza por unidad; mandar el lote en paralelo apilar\u00eda los muebles en el mismo punto. Cada unidad se manda cuando llega la respuesta de la anterior.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_carpeta_proyecto", "label": "Carpeta del proyecto (contiene \u00abMain Components\u00bb)", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_validacion_previa_importacion", "label": "Validaci\u00f3n previa de importaci\u00f3n sin efectos secundarios", "file_type": "rationale", "rationale": "La tabla de revisi\u00f3n valida fila por fila con los mismos predicados del formulario y no crea nada \u2014ni geometr\u00eda, ni archivos, ni registros\u2014 hasta que el operador confirma; la importaci\u00f3n es acumulativa, no destructiva.", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_eliminar_ocultos", "label": "Eliminar piezas ocultas al generar", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_union_entrepanos", "label": "Fusi\u00f3n de mitades de entrepa\u00f1o del Esquinero (Solid Tools)", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_familias", "label": "Familias: Gabinete, Alacena, Esquinero", "file_type": "concept", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_introspeccion_rb", "label": "introspeccion.rb \u2014 volcado de atributos y f\u00f3rmulas", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a79.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_script_rb_legado", "label": "script.rb \u2014 script legado de generaci\u00f3n por CSV", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_sondas_diagnostico", "label": "Sondas de diagn\u00f3stico Issues/diag_*.rb", "file_type": "code", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a79.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_riesgos_operativos", "label": "Riesgos operativos y mitigaci\u00f3n", "file_type": "document", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_tecnico_roadmap", "label": "Roadmap y siguientes pasos", "file_type": "document", "source_file": "MANUAL_TECNICO.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "manual_tecnico_arquitectura_ruby_js", "target": "manual_tecnico_puente_mensajes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MANUAL_TECNICO.md", "source_location": "62", "weight": 1.0}, {"source": "manual_tecnico_main_rb", "target": "manual_tecnico_engine_rb", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MANUAL_TECNICO.md", "source_location": "123